<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Platform cleartext is on so a user-acknowledged http origin can connect.
         OkHttp still refuses http unless that origin was acknowledged. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
